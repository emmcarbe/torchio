                  "element": "lem",
                  "section": "4-apparato",
                  "atts": {
                   "wit": "#A"
                  },
                  "children": [
                   "indol"
                  ]
                 },
                 {
                  "id": "specimen:0.1.0.0.1.4.0.1",
                  "element": "rdg",
                  "section": "4-apparato",
                  "atts": {
                   "wit": "#B #C",
                   "type": "ortografica"
                  },
                  "children": [
                   "indole"
                  ]
                 }
                ]
               },
               " conobbe; che sovr'esso il mare"
              ]
             },
             "\n          ",
             {
              "id": "specimen:0.1.0.0.1.5",
              "element": "l",
              "section": "1-versi",
              "atts": {},
              "children": [
               "molti dentro del cor sofferse affanni,"
