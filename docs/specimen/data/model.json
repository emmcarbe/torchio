                "id": "specimen:0.1.0.0.1.2.0",
                "element": "placeName",
                "section": "2-entita",
                "atts": {
                 "ref": "#troia"
                },
                "children": [
                 "Ilïòn"
                ]
               },
               " le sacre torri;"
              ]
             },
             "\n          ",
             {
              "id": "specimen:0.1.0.0.1.3",
              "element": "l",
              "section": "1-versi",
              "atts": {},
              "children": [
               "che città vide molte, e delle genti"
              ]
             },
             "\n          ",
             {
              "id": "specimen:0.1.0.0.1.4",
              "element": "l",
              "section": "1-versi",
              "atts": {},
              "children": [
               "l'",
