                "element": "del",
                "section": "3-trascrizionale",
                "atts": {
                 "hand": "#m1"
                },
                "children": [
                 "salvar"
                ]
               },
               {
                "id": "specimen:0.1.0.0.1.6.1",
                "element": "add",
                "section": "3-trascrizionale",
                "atts": {
                 "hand": "#m2",
                 "place": "above"
                },
                "children": [
                 "redimer"
                ]
               },
               " cercava a sé la vita,"
              ]
             },
             "\n          ",
             {
              "id": "specimen:0.1.0.0.1.7",
              "element": "l",
              "section": "1-versi",
              "atts": {},
              "children": [
               "e il ritorno a' compagni."
